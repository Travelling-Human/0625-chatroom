# Copy this file to .env and fill in your own values.
# cp .env.example .env

# Your MongoDB connection string (MongoDB Atlas free tier recommended on Termux,
# since MongoDB doesn't run natively on Android). See README.md for setup steps.
MONGODB_URI=mongodb+srv://USERNAME:[email protected]/0625?retryWrites=true&w=majority

# Port the server listens on
PORT=3000

# Max length (seconds) for a single voice message
MAX_VOICE_SECONDS=60

# Max size (bytes) for a single voice message upload (~2MB default)
MAX_VOICE_BYTES=2097152

# Secret key for the admin console (/admin.html) — used to ban/unban IPs and
# look up message senders. Make this long and random. Keep it private —
# anyone with this key has full moderation access.
ADMIN_KEY=change-this-to-a-long-random-string
